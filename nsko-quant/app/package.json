    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "engine:stub": "node -e \"const fs=require('fs'),cp=require('child_process');const t=cp.execSync('rustc -vV').toString().match(/host: (.+)/)[1];const w=t.includes('windows');const f='src-tauri/binaries/nsko-quant-engine-'+t+(w?'.exe':'');fs.mkdirSync('src-tauri/binaries',{recursive:true});if(!fs.existsSync(f)){fs.writeFileSync(f,'#!/bin/sh\\necho placeholder engine >&2\\nexit 1\\n',{mode:0o755});console.log('wrote',f)}\""
  },
