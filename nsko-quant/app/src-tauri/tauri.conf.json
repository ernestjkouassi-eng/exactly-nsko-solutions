{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NSKO QUANT",
  "mainBinaryName": "nsko-quant",
  "version": "0.2.0",
  "identifier": "uk.co.nsko.quant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NSKO QUANT",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "visible": false,
        "backgroundColor": "#08080F",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://tile.openstreetmap.org https://server.arcgisonline.com https://services.arcgisonline.com; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787 ws://127.0.0.1:8787 https://tile.openstreetmap.org https://server.arcgisonline.com https://services.arcgisonline.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NSKO Solutions",
    "copyright": "© 2026 NSKO Solutions",
    "category": "Finance",
    "shortDescription": "Personal automated trading desk",
    "longDescription": "NSKO QUANT · by NSKO Solutions. A personal automated trading desk. The local engine runs 24/7 in the background on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/nsko-quant-engine"],
    "createUpdaterArtifacts": false,
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_REPLACE_WITH_OUTPUT_OF_npx_tauri_signer_generate",
      "endpoints": ["https://updates.example.com/nsko-quant/latest.json"]
    }
  }
}
