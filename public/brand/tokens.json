{
  "name": "NSKO Solutions v4.2",
  "slogan": "Build beyond.",
  "support": "Complex made real.",
  "color": {
    "obsidian": "#0B0B0D", "carbon": "#1A1C20", "spectral": "#F0F0FA", "paper": "#F4F4F2",
    "mist": "#E9EAEC", "frost": "#CFE0EC", "steel": "#8C95A0",
    "signal": { "value": "#E8541A", "use": "dot, hairline, logo fragment only; never text or button fill" },
    "live": { "value": "#E5241B", "use": "LIVE dot only" }
  },
  "type": {
    "display": { "family": "D-DIN, Barlow, sans-serif", "case": "uppercase", "tracking": "0.05em", "weight": "500-600" },
    "label": { "family": "D-DIN, Barlow, sans-serif", "case": "uppercase", "tracking": "0.14em", "size": "11-12px" },
    "body": { "family": "Inter, sans-serif", "weight": 400, "size": "16-18px" },
    "wordmark": { "family": "Inter", "weight": 900 }
  },
  "button": {
    "primary": { "bg": "#FFFFFF", "fg": "#0B0B0D", "radius": "999px", "rule": "one per screen" },
    "secondary": { "bg": "rgba(240,240,250,.1)", "border": "1px solid rgba(240,240,250,.35)", "fg": "#F0F0FA", "radius": "999px" }
  },
  "motion": { "ease": "cubic-bezier(.22,1,.36,1)", "duration": "600-900ms", "tiltMax": "6deg", "parallax": "8-24px", "grain": "3%" },
  "forbidden": ["cutting-edge", "revolutionary", "next-gen", "exclamation marks", "scroll-jacking", "sound", "loaders", "counters", "marquees", "particles", "neon"]
}
